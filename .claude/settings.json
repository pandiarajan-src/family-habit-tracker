{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(uv run *)",
      "Bash(npm run *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(gh pr view*)",
      "Bash(gh pr create *)",
      "Bash(gh issue view*)",
      "Read(./.env.example)",
      "Bash(git branch -D *)",
      "Bash(git checkout -b *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force*)",
      "Bash(rm -rf *)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/settings.json)"
    ],
    "ask": [
      "Bash(dangerouslyDisableSandbox:true)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr *)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-pr-gate.py",
            "timeout": 600
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-secrets.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-paths.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-on-edit.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv",
        "~/.npm",
        "~/Library/Caches/ms-playwright"
      ],
      "denyWrite": [
        "./.env",
        "./backend/.env",
        "./frontend/.env",
        "./.github/workflows",
        "./.claude/settings.json",
        "./.claude/hooks"
      ],
      "denyRead": [
        "./.env",
        "./backend/.env",
        "./frontend/.env"
      ],
      "allowRead": [
        "./.env.example"
      ]
    },
    "network": {
      "allowedDomains": [
        "localhost",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "api.osv.dev"
      ],
      "allowLocalBinding": true
    }
  }
}
