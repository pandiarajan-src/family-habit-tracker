# Copy to `.env` (git-ignored) and adjust. `make` loads `.env` automatically.

# Which config the backend runs with: dev | test | e2e | prod.
APP_ENV=dev

# SQLAlchemy database URL. SQLite file DB locally; tests use a temp file per test.
# The path is relative to backend/. Postgres also works if a host has no persistent disk,
# e.g. postgresql+psycopg://user:password@host:5432/family_habit_tracker
DATABASE_URL=sqlite:///./family_habit_tracker.db

# Mark the session cookie Secure. Defaults to true only when APP_ENV=prod.
# Keep it false on http://localhost (WebKit drops Secure cookies there).
COOKIE_SECURE=false

# Python log level for the API.
LOG_LEVEL=INFO

# Ports for `make dev`.
BACKEND_PORT=8000
FRONTEND_PORT=5173
